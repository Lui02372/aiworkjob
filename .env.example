# Copy to .env locally. Never commit real keys. Default: no checkout, no real charges.
AIWORKJOB_PAYMENT_MODE=disabled
# Example local test origin; use your own HTTPS server origin for a live shop.
AIWORKJOB_PUBLIC_ORIGIN=http://127.0.0.1:8787
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
AIWORKJOB_STORE_DB=data/store.sqlite
AIWORKJOB_SELLER_NAME=
AIWORKJOB_SELLER_EMAIL=
AIWORKJOB_SELLER_BUSINESS_NUMBER=
AIWORKJOB_SELLER_ADDRESS=
AIWORKJOB_REFUND_POLICY=
AIWORKJOB_ADMIN_TOKEN=
# Set yes only after completing your own merchant contract, settlement and shop configuration.
AIWORKJOB_LIVE_PAYMENTS_ENABLED=no
# Account manager: server only. Store the actual env file under commonn/runtime/<project>/<channel>/.
AUA_URL=http://127.0.0.1:8780
AUA_TOKEN=
